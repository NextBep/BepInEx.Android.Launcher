    <string name="onboarding_welcome_title">Launch from this app</string>
    <string name="onboarding_welcome_body">Mods are injected by the launcher. Start the game here — don\'t tap the original game icon on your home screen.</string>
    <string name="onboarding_game_title">Install the game first</string>
    <string name="onboarding_game_body_missing">Plants vs. Zombies: Fusion was not detected. Install it, then tap Scan again.</string>
