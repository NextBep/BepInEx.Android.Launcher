    <!-- About -->
    <string name="about_title">BepInEx Android 啟動器</string>
    <string name="about_description">一個在 arm64 平台上的 BepInEx 啟動器</string>
    <string name="about_disclaimer">⚠ BepInEx 啟動器 未獲得 BepInEx 的官方支援。</string>
    <string name="about_projects_section">本專案使用 &amp; 借鑑的專案</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Unity IL2CPP 模組框架 — 核心外掛載入器。BepInEx 6.0.0-pre.2，由 BepInEx 團隊開發。</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Starlight 團隊的 Android Unity IL2CPP 執行階段容器。注入鏈、Pine Hook 與 NativeLoader 架構的主要參考。</string>
    <string name="about_project_nextbep_name">NextBep (BepInEx.Android)</string>
    <string name="about_project_nextbep_desc">我們客製化的 Android BepInEx 分支。將 BepInEx 6 適配到嵌入式 CoreCLR + IL2CPP interop。</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET 執行階段 v10.0.5。從原始碼建置，使用 OpenSSL 加密後端修復 Android 16 上的 BoringSSL SIGSEGV 崩潰。</string>
    <string name="about_project_openssl_name">OpenSSL</string>
    <string name="about_project_openssl_desc">OpenSSL 3.4.0 — 取代 BoringSSL 用於 ARM64 Android 加密。提供 libcrypto.so + libssl.so。</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">ART Java 方法 Hook 框架 (top.canyie.pine:core:0.3.0)。用於 ClassLoader、PackageManager 與 UnityPlayer hook。</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">ARM64 原生 Hook 框架。用於 libnextbep 中的 il2cpp_init hook。</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">IL2CPP 逆向工程工具。用於 interop 組件生成。</string>
